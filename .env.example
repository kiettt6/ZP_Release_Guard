# ---- Runtime mode ----
APP_MODE=api                       # api | bot
ZP_RELEASE_GUARD_API_URL=http://127.0.0.1:8080

# ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=123456789:replace-with-real-token
TELEGRAM_BOT_ENABLE_POLLING=false  # only true on a single-instance deployment

# ---- LLM (VNG MaaS by default; OpenAI-compatible) ----
LLM_API_KEY=                       # unset = LLM features disabled (graceful fallback)
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=openai/gpt-5
LLM_ENABLE_REWRITE=false           # true to enable the optional LLM report rewrite

# ---- API security ----
APP_API_KEY=                       # if set, /chat, /chat-upload, /analyze-freeform, /invocations require header X-API-Key
RATE_LIMIT_PER_MINUTE=120          # per-IP cap on the LLM-calling endpoints
